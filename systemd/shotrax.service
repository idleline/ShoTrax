[Unit]
Description=ShoTrax container stack and shared SNI edge
Requires=docker.service
After=docker.service network-online.target crystal-baseball.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/shotrax/current
ExecStart=/usr/bin/docker compose up -d --remove-orphans
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
